{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:authz": "node --env-file-if-exists=.env scripts/seed-authz.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:rechecks": "node scripts/security-recheck.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tabler/icons-react": "^3.42.0",
    "@workspace/ui": "*",
    "bcryptjs": "^3.0.3",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
