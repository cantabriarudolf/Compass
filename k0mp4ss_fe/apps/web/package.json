{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "//": "Variables de entorno obligatorias en producción: DATABASE_URL (Prisma), AUTH_SECRET (Auth.js). Recomendadas: NEXT_PUBLIC_APP_ENV=production (explícita; NODE_ENV=production ya la fija el build de Next). No commitear secretos reales: solo .env local / dashboard de Vercel.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:nongated": "playwright test --grep-invert GATED",
    "e2e:gated": "playwright test --grep GATED",
    "e2e:full-orden": "playwright test --grep-invert GATED && playwright test --grep GATED",
    "e2e:reseed-base": "npm run seed:authz && npm run seed:mocks -- --comunidad-id=comunidad-a",
    "seed:authz": "node --env-file-if-exists=.env scripts/seed-authz.mjs",
    "seed:mocks": "vite-node scripts/seed-db-from-mocks.ts",
    "cifrar:datos": "node --env-file-if-exists=.env scripts/cifrar-datos-existentes.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:rechecks": "node scripts/security-recheck.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:sync-schema": "node scripts/sync-schema.mjs",
    "db:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:dev": "prisma migrate dev --schema=prisma/schema.sqlite.prisma",
    "db:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:prod:generate": "prisma generate",
    "db:prod:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^3.0.1",
    "@sentry/nextjs": "^10.74.0",
    "@tabler/icons-react": "^3.42.0",
    "@workspace/ui": "*",
    "bcryptjs": "^3.0.3",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.11",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "speakeasy": "^2.0.0",
    "swr": "^2.5.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^3.2.7",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  }
}
