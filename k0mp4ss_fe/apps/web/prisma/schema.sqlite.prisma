  montoSalud                Float
  tasaSIS                   Float
  montoSIS                  Float
  montoSeguroCesantia       Float
  montoAPV                  Float
  totalDescuentos           Float
  descuentoAnticipos        Float
  adelantosIds              Json
  // SERIE-FASE2 §V4 — plan de deducción por adelanto con su tope aplicado y el
  // arrastre resultante; lo calcula el servidor al generar (nunca el cliente) y lo
  // consume la confirmación para actualizar saldo/estado sin recalcular.
  adelantosDetalle          Json?
  alcanceLiquido            Float
  liquidoAPagar             Float
  estado                    String
  egresoFIReferencia        String?
  proyeccionPEReferencia    String?
