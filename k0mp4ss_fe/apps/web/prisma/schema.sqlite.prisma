model AdelantoPL {
  id                  String    @id
  comunidadId         String
  comunidad           Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  folio               String
  trabajadorPersonaId String
  fecha               String
  monto               Float
  glosa               String
  estado              String
  liquidacionId       String?
  // SERIE-FASE2 §V4 — dos naturalezas, nunca una sola (doctrina DT ORD 2676/140):
  // `anticipo_regular` = pago anticipado de lo devengado (se descuenta 100% en la
  // liquidación siguiente, sin tope 15%); `prestamo` = deuda con acuerdo escrito,
  // topada al 15% mensual de la remuneración bruta y al 45% conjunto (art. 58 inc. 3-4).
  pacto               String    @default("anticipo_regular")
  // Saldo vivo: el arrastre cuando el líquido del período no alcanza.
  saldo               Float     @default(0)
  // Período en que corresponde imputar el descuento (AAAA-MM); "" = legado
  // (se imputa en la liquidación siguiente que se genere).
  periodoImputacion   String    @default("")
  // Referencia al acuerdo escrito/firmado del préstamo (obligatoria si pacto = prestamo).
  acuerdoEscritoRef   String?
  creadoPor           String?
  aprobadoPor         String?
  comprobante         String?
  // Auditoría de cada deducción aplicada, ligada a su liquidación.
  deducciones         Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([comunidadId])
  @@index([trabajadorPersonaId])
  @@index([comunidadId, trabajadorPersonaId, estado])
  @@map("adelantos_pl")
}

