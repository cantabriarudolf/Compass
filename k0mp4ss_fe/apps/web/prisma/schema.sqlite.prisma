/// F35 serie A — archivo de documentos de la comunidad (Ley 21.442 art. 9).
///
/// Una sola entidad, dos naturalezas:
///   · `legal`      ⊂ append-only: no se edita ni se borra; se corrige con otra versión.
///                    Exige `referenciaAutentica` (fojas/fecha/notaría o Conservador).
///   · `comunitario` ⊂ reemplazable: se edita y se borra con la clave `doc`.
///
/// D1 (media por referencia): el archivo son metadatos + URL, nunca bytes ni
/// base64. `version` la asigna el servidor dentro de
/// (comunidadId, tipoDocumental); el cliente no la manda.
/// `subidoPorPersonaId` no lleva FK a propósito: la procedencia del documento
/// debe sobrevivir a una fusión o baja del padrón.
model Documento {
  id                  String              @id
  comunidadId         String
  comunidad           Comunidad           @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  naturaleza          String // "legal" | "comunitario" (lista cerrada en lib/documento-archivo.ts)
  tipoDocumental      String // lista cerrada de la ley + "otros"
  glosa               String // a qué corresponde el documento, en palabras del que lo sube
  referenciaAutentica String? // fojas/fecha/notaría o Conservador; obligatoria si es legal
  archivoNombre       String
  archivoTipoMime     String
  archivoTamanoKB     Float
  archivoUrl          String
  hash                String? // SHA-256 hex del archivo, cuando se puede calcular fuera del sistema
  version             Int
  vigenteDesde        String // fecha calendario AAAA-MM-DD, no instante: ver VersionReglamento
  subidoPorPersonaId  String?
  createdAt           DateTime            @default(now())
  // Relación inversa VIRTUAL (no genera columna): la constancia de entrega de
  // lo legal vive en `envios_documento` (A3).
  envios              EnvioDocumento[]
  // Relación inversa VIRTUAL (no genera columna): las versiones del reglamento
  // del cobro que este documento LEGAL respalda (A4 · S9).
  versionesReglamento VersionReglamento[]

  // Una sola línea de historia por tipo: dos altas concurrentes no pueden
  // quedarse con el mismo número (la segunda responde 409).
  @@unique([comunidadId, tipoDocumental, version])
  @@index([comunidadId, naturaleza])
  @@index([comunidadId, tipoDocumental])
  @@map("documentos")
}

// Entrega de un documento LEGAL y su constancia por destinatario (F35 serie A,
// A3 · S7/S8).
//
// Una fila por (documento, persona, canal). Lo legal conserva la constancia por
// destinatario; lo comunitario NO se entrega persona por persona: se publica al
// visor de toda la comunidad y su constancia es "publicado" (S8), así que la
// ruta de envío lo rechaza (409) en vez de fabricar entregas.
//
// Estados por canal (mismo contrato que `EnvioAvisoCobro`, con un matiz):
//   · visor → `entregado`: la fila de `Notificacion` se creó en la MISMA
//     transacción y `notificacionId` la prueba. No hay entrega declarada sin la
//     fila que la prueba.
//   · email → `entregado` SOLO si el servidor SMTP aceptó el mensaje (F4,
//     `lib/smtp.ts`); `pendiente` cuando la comunidad no tiene emisor
//     configurado (condición de configuración, no envío) y `fallido` cuando se
//     intentó y rebotó. El aviso llama `enviado` a la aceptación del servidor;
//     acá el vocabulario del documento la llama `entregado` porque el correo es
//     su único canal de constancia.
model EnvioDocumento {
  id             String    @id
  comunidadId    String
  comunidad      Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  documentoId    String
  documento      Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  // Destinatario de registro: la persona a la que se le entregó el documento.
  personaId      String
  // `visor` | `email` (CANALES_ENVIO_DOCUMENTO en app/api/documentos/_lib).
  canal          String
  // `entregado` | `pendiente` | `fallido` (ver arriba qué significa cada uno).
  estado         String
  fecha          String
  motivo         String?
  // La notificación que prueba la entrega por el visor (null en email).
  notificacionId String?
  claveEnvio     String
  reenvio        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  // Idempotencia: entregar el mismo documento a la misma persona por el mismo
  // canal choca acá; el reenvío explícito agrega un sufijo `:reenvio:<epoch>`.
  @@unique([comunidadId, claveEnvio])
  @@index([comunidadId])
  @@index([documentoId])
  @@index([personaId])
  @@map("envios_documento")
}

