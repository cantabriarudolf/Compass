  // Folio del libro de actas (Ley 21.442 art. 15: libro de actas foliado).
  // Formato `AD-<año>-<correlativo de 4 dígitos>`, asignado por el servidor al
  // crear el acta y NUNCA reasignado: el folio es la cita del acta.
  folio             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Garantía dura contra la carrera de folios: si dos altas leen el mismo
  // máximo, la segunda choca con este índice y el POST reintenta con el
  // siguiente (mismo patrón que certificados CT). Aditiva: ver migración
  // add_actas_gd_folio.
  @@unique([comunidadId, folio])
  @@index([comunidadId])
  @@map("actas_gd")
}

// Archivo de borrado lógico GD: copia íntegra del acta al momento de
// desestimarla; la fila original nunca se borra y queda como "desestimada".
