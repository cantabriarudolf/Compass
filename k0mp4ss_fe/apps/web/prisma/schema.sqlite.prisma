  diasTrabajados            Int
  sueldoBaseContrato        Float
  diasMesComercial          Int
  jornadaSemanal            Float
  sueldoBaseProporcional    Float
  horasExtrasHoras          Float
  valorHoraOrdinaria        Float
  montoHorasExtras          Float
  bonos                     Json
  gratificacionLegal        Float
  totalImponible            Float
  asignacionMovilizacion    Float
  asignacionColacion        Float
  asignacionFamiliarTramoId String?
  cargas                    Int
  montoAsignacionFamiliar   Float
  totalHaberes              Float
  afpId                     String?
  nombreAfp                 String
  tasaAFP                   Float
  montoAFP                  Float
  saludId                   String?
  nombreSalud               String
  saludTipo                 String
  saludPorcentaje           Float?
