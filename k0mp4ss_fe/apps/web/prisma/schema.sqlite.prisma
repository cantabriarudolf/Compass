// Aviso de cobro mensual (S1, S4, S7 — serie aviso-de-cobro): el PAPEL con el
// que se cobra. Existe por unidad y período, se emite una sola vez y guarda
// copia congelada del contenido y de los parámetros con los que se calculó
// (`contenido`) más los totales de comunidad del período (`totalesComunidad`,
// Ley 21.442 art. 31: ingresos, egresos y saldo de caja).
//
// No se edita ni se borra: es el documento que funda el plazo de pago y el
// título ejecutivo. Un cambio posterior en el cargo o en la caja NO reescribe
// el aviso ya emitido (ver `lib/aviso-cobro.ts`).
model AvisoCobro {
  id                 String            @id
  comunidadId        String
  comunidad          Comunidad         @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  unidadId           String
  // Período AAAA-MM del aviso (ordenable como texto, igual que el cobro).
  periodo            String
  folio              String
  codigoVerificacion String
  fechaEmision       String
  vencimiento        String?
  contenido          Json
  totalesComunidad   Json
  createdAt          DateTime          @default(now())
  // S3: las entregas del papel. El aviso no se borra nunca, así que la cascada
  // sólo se dispararía al borrar la comunidad.
  entregas           EnvioAvisoCobro[]

  // Folio correlativo POR COMUNIDAD (`AC-####`): lo asigna el servidor en la
  // transacción de emisión y este índice es la garantía dura contra la carrera
  // entre dos emisiones concurrentes (mismo patrón que los certificados CT).
  @@unique([comunidadId, folio])
  // El código de verificación se sortea contra los ya emitidos de la comunidad;
  // el índice lo vuelve una garantía, no una esperanza.
  @@unique([comunidadId, codigoVerificacion])
  // Una unidad no puede tener dos avisos del mismo período: se cobra una vez.
  @@unique([comunidadId, unidadId, periodo])
  @@index([comunidadId])
  @@index([unidadId])
  @@index([periodo])
  @@map("avisos_cobro")
}

// Entrega del aviso de cobro (S3 — serie aviso-de-cobro): la prueba de que el
// PAPEL llegó a una persona por un canal concreto.
//
// Por qué NO alcanza `Notificacion`: la bandeja interna es el canal visor real,
// pero no modela el estado de una entrega (ni `pendiente` ni `fallido`), no
// guarda el motivo por el que un canal no salió y no tiene clave de
// idempotencia, así que no puede impedir que re-entregar el mismo aviso
// duplique el registro. Por qué NO alcanza `EnvioCobranzaFI`: el aviso no es un
// cobro (`cobroId` es obligatorio y su vocabulario de estados es
// `pendiente|enviado|fallido`, donde `enviado` es el email que NUNCA salió) y
// esa tabla es el historial de la gestión de deuda por unidad. Se reusa el
// `Notificacion` como canal visor y esta tabla guarda el registro, con la misma
// idempotencia de `envios_cobranza_fi` (`claveEnvio` único por comunidad).
model EnvioAvisoCobro {
  id             String     @id
  comunidadId    String
  comunidad      Comunidad  @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  avisoId        String
  aviso          AvisoCobro @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  // Destinatario de registro: el propietario VIGENTE de la unidad del aviso.
  personaId      String
  // `visor` | `email` (CANALES_ENTREGA_AVISO en lib/schemas.ts).
  canal          String
  // `entregado` | `pendiente` | `fallido`. El visor es `entregado` porque la
  // fila de `Notificacion` se creó en la misma transacción; el email es
  // `pendiente` mientras no exista emisor SMTP (F4).
  estado         String
  fecha          String
  motivo         String?
  // La notificación que prueba la entrega por el visor (null en email).
  notificacionId String?
  claveEnvio     String
  reenvio        Boolean    @default(false)
  createdAt      DateTime   @default(now())

  // Idempotencia: re-entregar el mismo aviso a la misma persona por el mismo
  // canal choca acá; el reenvío explícito agrega un sufijo `:reenvio:<epoch>`.
  @@unique([comunidadId, claveEnvio])
  @@index([comunidadId])
  @@index([avisoId])
  @@index([personaId])
  @@map("envios_aviso_cobro")
}

// Cobranza FI multicanal (SERIE-FASE2 §V5): visor interno + email, con
// interruptor por residente y global de la comunidad.
//
// Tres piezas, ninguna duplica `Notificacion`: la notificación interna sigue
// siendo el canal visor real (la crea la ruta de cobranza), mientras que estas
// tablas guardan los INTERRUPTORES y el REGISTRO auditable de cada envío
// (canal, fecha, destinatario, estado y motivo), que `Notificacion` no modela.

/// Interruptor global de la comunidad (singleton por comunidad).
model ConfiguracionCobranzaFI {
  id             String    @id
  comunidadId    String    @unique
  comunidad      Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  canalVisor     Boolean   @default(true)
  canalEmail     Boolean   @default(true)
  actualizadoPor String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([comunidadId])
  @@map("configuracion_cobranza_fi")
}

/// Preferencia de canal del residente (una por persona y comunidad).
model PreferenciaCanalCobranzaFI {
  id             String    @id
  comunidadId    String
  comunidad      Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  personaId      String
  canalVisor     Boolean   @default(true)
  canalEmail     Boolean   @default(true)
  actualizadoPor String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([comunidadId, personaId])
  @@index([comunidadId])
  @@map("preferencias_canal_cobranza_fi")
}

///
/// Registro de UN envío de cobranza (por canal y destinatario).
///
/// `estado`: pendiente (en la cola de salida, sin emisor SMTP) | enviado (el
/// visor interno quedó publicado) | fallido (intento con error, con `motivo`).
/// `claveEnvio` es la idempotencia: unidad + destinatario + canal, con sufijo de
/// timestamp cuando el administrador pide un reenvío explícito.
model EnvioCobranzaFI {
  id              String    @id
  comunidadId     String
  comunidad       Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  cobroId         String
  unidadId        String
  personaId       String?
  canal           String
  estado          String
  fecha           String
  motivo          String?
  montoTotal      Float     @default(0)
  cobrosIncluidos Json // string[] de cobros vencidos cubiertos por la gestión
  claveEnvio      String
  reenvio         Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@unique([comunidadId, claveEnvio])
  @@index([comunidadId])
  @@index([cobroId])
  @@index([unidadId])
  @@map("envios_cobranza_fi")
}

