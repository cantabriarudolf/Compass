/// Vigencia del Registro de Copropietarios (Ley 21.442 art. 9 y Reglamento de la
/// ley, D.O. 09-01-2025). S2: el reloj corre por UNIDAD, no por persona — una fila
/// por unidad con los hechos del ciclo. S6: los hechos quedan congelados; el
/// estado NO se persiste, se deriva con `lib/vigencia-registro.ts`, para que no
/// existan dos verdades que se separen con el tiempo.
model VigenciaRegistroUnidad {
  id                  String    @id @default(cuid())
  comunidadId         String
  comunidad           Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  unidadId            String
  /// Fecha de la última declaración **o revalidación** (S3: confirmar sin cambios
  /// es cumplir). `null` = no consta declaración: se reporta `sin_declaracion` y
  /// NO se multa (S1: no se inventa la falta).
  ultimaActualizacion DateTime?
  /// Acto de requerir vigente: es el que arranca los 60 días corridos (S2).
  /// Al declarar o revalidar se limpia; la historia queda en RequerimientoVigencia.
  requerimientoEn     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([comunidadId, unidadId])
  @@index([comunidadId])
  @@map("vigencia_registro_unidad")
}

/// Evidencia inmutable del requerimiento anual (S6): append-only, una fila por
/// acto, con el vencimiento congelado en el momento de requerir. Es la prueba de
/// que la administración cumplió su deber del art. 9; nada la edita ni la borra.
model RequerimientoVigencia {
  id            String    @id @default(cuid())
  comunidadId   String
  comunidad     Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  unidadId      String
  fecha         DateTime  @default(now())
  /// `fecha + 60 días corridos`, calculado UNA sola vez en el acto (S6):
  /// recalcularlo después permitiría mover el plazo cambiando un dato.
  venceEn       DateTime
  registradoPor String
  fundamento    String
  createdAt     DateTime  @default(now())

  @@index([comunidadId, unidadId])
  @@map("requerimientos_vigencia")
}

/// Evidencia inmutable de una revalidación (S3): confirmar que el registro sigue
/// igual es cumplir. Append-only: la declaración no se borra ni se edita.
model RevalidacionVigencia {
  id            String    @id @default(cuid())
  comunidadId   String
  comunidad     Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  unidadId      String
  fecha         DateTime  @default(now())
  revalidadoPor String
  /// Qué se confirmó que sigue igual, en palabras de quien revalidó:
  /// un «sigue igual» sin contenido no sirve como evidencia.
  detalle       String
  /// S5 — quién declaró: `administrador` | `propietario` | `arrendatario`.
  /// Sale del vínculo del usuario de sesión, nunca del cuerpo del request: es la
  /// procedencia de la declaración y no puede elegirse. El default conserva como
  /// administrativas las filas escritas antes de existir este campo.
  origen        String    @default("administrador")

  @@index([comunidadId, unidadId])
  @@map("revalidaciones_vigencia")
}

/// Registro de idempotencia y de constancia de los avisos de vigencia emitidos
/// (S8). Una fila por (unidad, tipo de aviso, hito): volver a correr el barrido no
/// duplica avisos ni notificaciones.
model AvisoVigencia {
  id             String    @id @default(cuid())
  comunidadId    String
  comunidad      Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  unidadId       String
  tipo           String
  destinatario   String
  hito           String
  notificacionId String
  emitidoEn      DateTime  @default(now())
  @@unique([comunidadId, unidadId, tipo, destinatario, hito])
  @@index([comunidadId])
  @@map("avisos_vigencia")
}

/// Propuesta de multa por Registro no actualizado (S4): el sistema la propone con
/// el monto congelado del maestro de la comunidad y la aplica el Comité con su acuerdo.
/// Una propuesta por ciclo: la clave es la unidad y el acto de requerir que abrió los
/// 60 días. El monto y el ancla legal se congelan al proponer, así que cambiar el
/// maestro después no mueve la propuesta: esa es la evidencia.
model PropuestaMultaVigencia {
  id                  String    @id @default(cuid())
  comunidadId         String
  comunidad           Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  unidadId            String
  /// Momento en que el sistema propuso la multa (acto explícito, sin cron: D5).
  fecha               DateTime  @default(now())
  /// Monto congelado del maestro de la comunidad al proponer (S1: nunca un valor
  /// del código ni un monto por defecto).
  monto               Float
  /// Ancla legal congelada: artículo del reglamento o acta que fija el monto.
  referenciaLegal     String?
  /// Fila del maestro de la que salió el monto; `null` si no consta.
  tipoInfraccionId    String?
  /// `propuesta` | `aplicada` | `desestimada`.
  estado              String    @default("propuesta")
  /// Ciclo que la origina: el acto de requerir que abrió los 60 días.
  requerimientoEn     DateTime
  propuestaPor        String
  /// Quién la aplicó (administrador o Comité) y cuándo.
  aplicadaPor         String?
  aplicadaEn          DateTime?
  /// Acuerdo del Comité que la aprobó: acta o número de acuerdo (exigido al aplicar).
  acuerdoReferencia   String?
  /// Infracción IN creada al aplicarla; `null` mientras siga propuesta o desestimada.
  infraccionId        String?
  motivoDesestimacion String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([comunidadId, unidadId, requerimientoEn])
  @@index([comunidadId])
  @@map("propuestas_multa_vigencia")
}

