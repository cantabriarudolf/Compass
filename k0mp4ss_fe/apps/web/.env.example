# Entorno de la aplicación (ver lib/env-guard.ts)
NEXT_PUBLIC_APP_ENV=development

# Base de datos (Prisma + PostgreSQL via Neon)
# Neon PostgreSQL (ver https://neon.tech). En dev local se puede usar SQLite para tests rápidos.
DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/dbname?sslmode=require"

# Autenticación Auth.js (ver lib/auth.ts, lib/auth.config.ts y spec AU - Autenticacion y Sesion.md §3)
# AUTH_SECRET firma/cifra el JWT de sesión (JWE). Obligatorio en producción.
AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# P4 (SERIE-PRODUCCION-FASE2): cifrado AES-256-GCM de datos sensibles en reposo
# (ver lib/crypto.ts y lib/prisma-cifrado.ts). Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Obligatoria en producción (sin ella la app no arranca); en dev/test se usa dummy.
# Tras desplegar P4, migrar filas legacy una vez: npm run cifrar:datos
# CLAVE_CIFRADO_DATOS=cambia-esto-por-una-clave-de-al-menos-32-caracteres
# Deploy self-hosted: la config fija trustHost:true; si se despliega detrás de proxy,
# este proxy debe normalizar x-forwarded-* (documentado en manual de autenticación).
# Los usuarios de login viven en BD (tabla usuarios, passwordHash bcrypt) — sin
# credenciales de entorno. Primer arranque: `npm run seed:authz` (usuarios TEST
# admin@test.cl / test1234, dato de demo documentado en el manual).

# D-ii: dominio definitivo de producción (aún no existe; decisión owner).
# Todo lo de dominio SHALL ser configurable por env, no hardcodeado.
# Ej. cuando el owner defina: PUBLIC_DOMAIN=compass.example.cl
# HSTS preload se activa SOLO con dominio real (ver next.config.mjs).
PUBLIC_DOMAIN=

# C2-final: secretos de Configuración Global solo servidor (no cliente/store) — ver SG-hardening-despliegue C2
# SMTP_PASSWORD y CLAVE_ELIMINACION_MAESTRO no viven en lib/schemas.ts ni data/admin/configuracion.ts;
# se leen solo en el servidor (ej. route handlers) vía process.env. No versionar valores reales.
SMTP_PASSWORD=
CLAVE_ELIMINACION_MAESTRO=

# P5 (SERIE-PRODUCCION-FASE2): Sentry (observabilidad errores). Sin DSN el SDK es
# no-op. Owner: crear cuenta en https://sentry.io, proyecto Next.js, y pegar el DSN.
# SENTRY_AUTH_TOKEN solo para subir source maps en CI/prod (Settings > Auth Tokens).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN= (opcional; si se omite el cliente usa SENTRY_DSN)
# SENTRY_AUTH_TOKEN=

# Google SSO (OAuth 2.0) — opcional. Requiere credenciales de Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
