# Entorno de la aplicación (ver lib/env-guard.ts)
NEXT_PUBLIC_APP_ENV=development

# Base de datos (Prisma dual: SQLite dev local + PostgreSQL prod — ver
# openspec/changes/st-migracion-postgres/design.md y lib/prisma.ts).
# El schema fuente (prisma/schema.prisma) es postgresql; para dev local se
# genera prisma/schema.sqlite.prisma vía `npm run db:sync-schema`.
#
# Dev local (SQLite — default, rápido, sin Docker):
# OJO: Prisma resuelve los paths `file:` RELATIVO al schema (`prisma/`), no a
# la app. `file:./dev.db` => apps/web/prisma/dev.db. Escribir
# `file:./prisma/dev.db` acá crea una base vacía en `prisma/prisma/`.
# DATABASE_URL="file:./dev.db"
#
# Dev local contra PostgreSQL (Docker: docker compose -f docker-compose.db.yml up -d):
# DATABASE_URL="postgresql://compass:compass_dev_2024@localhost:5432/compass_dev"
#
# Prod (PostgreSQL vía Neon, ver https://neon.tech):
# La URL de Neon NO va en este archivo: el CLI de Prisma lee `.env` (ignora
# `.env.local`), así que una URL de producción acá deja `npm run db:prod:deploy`
# a un comando de migrar la base real. Guardarla en `.env.neon` (ignorado por
# git y por los loaders) y pasarla explícita cuando corresponda.
# DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# Autenticación Auth.js (ver lib/auth.ts, lib/auth.config.ts y spec AU - Autenticacion y Sesion.md §3)
# AUTH_SECRET firma/cifra el JWT de sesión (JWE). Obligatorio en producción.
AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# P4 (SERIE-PRODUCCION-FASE2): cifrado AES-256-GCM de datos sensibles en reposo
# (ver lib/crypto.ts y lib/prisma-cifrado.ts). Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Obligatoria en producción (sin ella la app no arranca); en dev/test se usa dummy.
# Tras desplegar P4, migrar filas legacy una vez: npm run cifrar:datos
# CLAVE_CIFRADO_DATOS=cambia-esto-por-una-clave-de-al-menos-32-caracteres
# Deploy self-hosted: la config fija trustHost:true; si se despliega detrás de proxy,
# este proxy debe normalizar x-forwarded-* (documentado en manual de autenticación).
# Los usuarios de login viven en BD (tabla usuarios, passwordHash bcrypt) — sin
# credenciales de entorno. Primer arranque: `npm run seed:authz` (usuarios TEST
# admin@test.cl / test1234, dato de demo documentado en el manual).

# D-ii: dominio definitivo de producción (aún no existe; decisión owner).
# Todo lo de dominio SHALL ser configurable por env, no hardcodeado.
# Ej. cuando el owner defina: PUBLIC_DOMAIN=compass.example.cl
# HSTS preload se activa SOLO con dominio real (ver next.config.mjs).
PUBLIC_DOMAIN=

# C2-final: secretos de Configuración Global solo servidor (no cliente/store) — ver SG-hardening-despliegue C2
# SMTP_PASSWORD y CLAVE_ELIMINACION_MAESTRO no viven en lib/schemas.ts ni data/admin/configuracion.ts;
# se leen solo en el servidor (ej. route handlers) vía process.env. No versionar valores reales.
SMTP_PASSWORD=
CLAVE_ELIMINACION_MAESTRO=

# P5 (SERIE-PRODUCCION-FASE2): Sentry (observabilidad errores). Sin DSN el SDK es
# no-op. Owner: crear cuenta en https://sentry.io, proyecto Next.js, y pegar el DSN.
# SENTRY_AUTH_TOKEN solo para subir source maps en CI/prod (Settings > Auth Tokens).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN= (opcional; si se omite el cliente usa SENTRY_DSN)
# SENTRY_AUTH_TOKEN=

# Google SSO (OAuth 2.0) — opcional en dev, REQUERIDO en producción.
# Requiere credenciales de Google Cloud Console (APIs & Services > Credentials).
# En producción, la app NO arrancará sin estas variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opt-out con bandera (change au-google-provider-disabled): con GOOGLE_PROVIDER_DISABLED=1
# (a) el fail-fast de producción NO corre y (b) el provider Google NO se registra
# (queda solo Credentials). Solo para builds/entornos sin credenciales Google (p. ej. CI);
# NO setear en un entorno de producción con SSO Google activo. Vacío o cualquier otro
# valor = bandera apagada (comportamiento normal). Ver docs/runbook-operaciones.md.
GOOGLE_PROVIDER_DISABLED=

# sg-csp-enforcement: CSP enforcement toggle (Report-Only vs Enforcement)
# false (default) = Content-Security-Policy-Report-Only (safe for telemetry window)
# true = Content-Security-Policy (active enforcement)
# Set to "true" ONLY after 7 consecutive days with zero CSP violations logged via /api/csp-report.
# Immediate rollback: set back to "false" — no code change, no redeploy needed.
CSP_ENFORCEMENT=false
