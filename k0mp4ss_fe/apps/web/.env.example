# Entorno de la aplicación (ver lib/env-guard.ts)
NEXT_PUBLIC_APP_ENV=development

# Base de datos (Prisma + SQLite dev) — ver prisma/schema.prisma y lib/prisma.ts (C1)
# En dev: SQLite archivo local (ruta relativa a prisma/schema.prisma). En prod el owner define DATABASE_URL contra Postgres gestionado.
DATABASE_URL="file:./dev.db"

# Autenticación Auth.js (ver lib/auth.ts, lib/auth.config.ts y spec AU - Autenticacion y Sesion.md §3)
# AUTH_SECRET firma/cifra el JWT de sesión (JWE). Obligatorio en producción.
AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
# Deploy self-hosted: la config fija trustHost:true; si se despliega detrás de proxy,
# este proxy debe normalizar x-forwarded-* (documentado en manual de autenticación).
# Los usuarios de login viven en BD (tabla usuarios, passwordHash bcrypt) — sin
# credenciales de entorno. Primer arranque: `npm run seed:authz` (usuarios TEST
# admin@test.cl / test1234, dato de demo documentado en el manual).

# C2-final: secretos de Configuración Global solo servidor (no cliente/store) — ver SG-hardening-despliegue C2
# SMTP_PASSWORD y CLAVE_ELIMINACION_MAESTRO no viven en lib/schemas.ts ni data/admin/configuracion.ts;
# se leen solo en el servidor (ej. route handlers) vía process.env. No versionar valores reales.
SMTP_PASSWORD=
CLAVE_ELIMINACION_MAESTRO=
