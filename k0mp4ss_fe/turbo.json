{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "COMPASS_ROOT",
    "NEXT_PUBLIC_APP_ENV",
    "APP_ENV",
    "NODE_ENV",
    "DATABASE_URL",
    "AUTH_SECRET",
    "CLAVE_CIFRADO_DATOS",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "AUTH_URL",
    "NEXTAUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "E2E_RATE_LIMIT",
    "BASE_URL",
    "CI",
    "ANALYZE",
    "NEXT_RUNTIME",
    "LOG_LEVEL",
    "CSP_ENFORCEMENT",
    "SQLITE_URL",
    "POSTGRES_URL",
    "DATABASE_URL_POSTGRES",
    "COMUNIDAD_ID",
    "SKIP_DATOS",
    "GOOGLE_PROVIDER_DISABLED",
    "E2E_ALLOW_WRITE_APIS"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
